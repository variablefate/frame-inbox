#!/usr/bin/env bash
# Right-click "Remove Frame Inbox (app and links)…" in the application menu.
#
# Uses a KDE dialog by default (no terminal needed, and it shows exactly what
# will be deleted). Falls back to a terminal, then to a plain message.
set -uo pipefail

# Menus launch with a thinner PATH than a login shell; /usr/sbin may be absent.
PATH="/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin:${PATH:-}"
export PATH

BASE="${FRAME_INBOX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/frame-inbox}"
SCRIPT="$BASE/uninstall.sh"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/frame-inbox-uninstall.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

has_display() { [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; }

notify_error() {
  echo "[$(date -Is)] $1" >>"$LOG"
  if has_display; then
    if command -v kdialog >/dev/null 2>&1; then
      kdialog --title "Frame Inbox" --error "$1" 2>/dev/null && return
    elif command -v zenity >/dev/null 2>&1; then
      zenity --error --text "$1" 2>/dev/null && return
    fi
  fi
  echo "$1" >&2
}

[ -f "$SCRIPT" ] || { notify_error "No uninstaller at $SCRIPT."; exit 1; }

if ! has_display; then
  notify_error "No display available - open a terminal and run: bash $SCRIPT"
  exit 1
fi

preview="$(bash "$SCRIPT" --dry-run 2>&1)"
echo "[$(date -Is)] --- run ---" >>"$LOG"
printf '%s\n' "$preview" >>"$LOG"

# KDE first: a dialog is what a menu action should produce.
if command -v kdialog >/dev/null 2>&1; then
  if kdialog --title "Remove Frame Inbox" --icon edit-delete \
       --yesno "${preview}"$'\n\n'"Remove all of this?"; then
    if bash "$SCRIPT" --yes >>"$LOG" 2>&1; then
      kdialog --title "Frame Inbox" --msgbox "Frame Inbox has been removed."
    else
      notify_error "Removal failed or was incomplete. Details: $LOG"
    fi
  fi
  exit 0
fi

if command -v zenity >/dev/null 2>&1; then
  if zenity --question --title "Remove Frame Inbox" --text "$preview"; then
    bash "$SCRIPT" --yes >>"$LOG" 2>&1 \
      && zenity --info --text "Frame Inbox has been removed." \
      || notify_error "Removal failed. Details: $LOG"
  fi
  exit 0
fi

for term in konsole x-terminal-emulator xfce4-terminal gnome-terminal xterm; do
  command -v "$term" >/dev/null 2>&1 || continue
  case "$term" in
    konsole)             exec konsole --hold -e bash "$SCRIPT" ;;
    x-terminal-emulator) exec x-terminal-emulator -e bash "$SCRIPT" ;;
    xfce4-terminal)      exec xfce4-terminal --hold -x bash "$SCRIPT" ;;
    gnome-terminal)      exec gnome-terminal -- bash -c "bash '$SCRIPT'; read -r _" ;;
    xterm)               exec xterm -e bash -c "bash '$SCRIPT'; read -r _" ;;
  esac
done

notify_error "No dialog or terminal found - run: bash $SCRIPT"
exit 1
