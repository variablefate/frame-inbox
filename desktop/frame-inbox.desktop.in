[Desktop Entry]
Type=Application
Name=Frame Inbox
GenericName=Link handoff
Comment=Start the link page your phone opens, send links to it, clear it
Exec=@EXEC@
Icon=frame-inbox
Terminal=false
Categories=Network;
Keywords=link;share;phone;inbox;
StartupNotify=true
StartupWMClass=frame-inbox
Actions=uninstall;

[Desktop Action uninstall]
Name=Remove Frame Inbox (app and links)…
Exec=@UNINSTALL@
Icon=edit-delete
